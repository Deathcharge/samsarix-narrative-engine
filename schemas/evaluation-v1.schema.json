{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Samsarix Pairwise Evaluation Manifest v1",
  "description": "Portable definition for deterministic blinded comparison of two treatments.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "seed", "rubric", "cases"],
  "properties": {
    "schema": {
      "const": "samsarix.evaluation/v1"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "run_bundle"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "run_bundle": {
          "description": "Forward-slash relative path contained by the manifest directory.",
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "treatments"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "treatments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/treatment"
          }
        }
      }
    }
  }
}
