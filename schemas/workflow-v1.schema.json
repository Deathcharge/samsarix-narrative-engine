{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Samsarix Narrative Workflow v1",
  "description": "Portable, bounded, ordered narrative workflow definition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "stages"],
  "properties": {
    "schema": {
      "const": "samsarix.workflow/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/stage"
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "system_prompt", "max_output_tokens", "context_from"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "system_prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "context_from": {
          "description": "Unique stage IDs that must refer only to earlier stages; enforced by the runtime.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        }
      }
    }
  }
}
