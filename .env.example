# Choose exactly one provider for a run. Never commit a populated .env file.
SAMSARIX_PROVIDER=openai
SAMSARIX_MODEL=gpt-5-mini
OPENAI_API_KEY=

# Anthropic alternative:
# SAMSARIX_PROVIDER=anthropic
# SAMSARIX_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# OpenAI-compatible alternatives supported by the CLI:
# XAI_API_KEY=
# PERPLEXITY_API_KEY=
